# ─── Gnani AI ────────────────────────────────────────────────────────────────
# Get your key at https://platform.gnani.ai
GNANI_API_KEY=your_gnani_api_key_here

# ─── Feature flags ───────────────────────────────────────────────────────────
# Set to "true" to expose /api/dev/* endpoints (STT + TTS smoke-test routes)
DEV_ENDPOINTS=true

# ─── Backend ─────────────────────────────────────────────────────────────────
BACKEND_PORT=8000
# MongoDB connection
MONGO_URI=mongodb://username:password@host:27017/tara?ssl=true&authSource=admin
MONGO_DB_NAME=tara_gnani

# ─── LLM (Phase 3+) ──────────────────────────────────────────────────────────
# GROQ_API_KEY=your_groq_key_here

# ─── Security (Phase 2+) ─────────────────────────────────────────────────────
# JWT_SECRET=change_me_to_random_secret
# JWT_ALGORITHM=HS256

